# Copy this file to .env and fill in the blanks. The real .env is gitignored.
# call_llm() reads ONLY these variables — switching providers must never
# require a code edit (§7.1).

# --- LLM provider -----------------------------------------------------------
# Which provider call_llm() uses: gemini | groq
PROVIDER=gemini

# Google AI Studio key (required when PROVIDER=gemini).
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq key (optional; required only when PROVIDER=groq).
# Get one at: https://console.groq.com/keys
GROQ_API_KEY=

# Model id for the selected provider. Lives ONLY here — never hardcoded.
#   gemini -> gemini-2.5-flash
#   groq   -> llama-3.3-70b-versatile   (single questions only; see §7.1)
MODEL_NAME=gemini-2.5-flash

# --- SEC EDGAR (FR-0) -------------------------------------------------------
# SEC requires a descriptive User-Agent of the form "Name email@example.com".
# Anonymous clients get HTTP 403. fetch_filings.py refuses to run until this
# is changed from the placeholder below to your real name and email.
SEC_USER_AGENT=Name email@example.com

# --- Retrieval / embeddings -------------------------------------------------
# Top-k chunks retrieved per question.
TOP_K=6

# Embedding model (sentence-transformers, CPU; ~130 MB first-run download).
EMBED_MODEL=BAAI/bge-small-en-v1.5
